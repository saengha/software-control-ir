# Copy to .env and fill the key. .env is gitignored.
GEMINI_API_KEY=

# Claude. Leave empty until you paste a key. Do not commit .env.
ANTHROPIC_API_KEY=
# SCIR_ANTHROPIC_API_KEY=

# Active live compare target. Comment/uncomment one block.
SCIR_COMPARE_PROVIDER=gemini
SCIR_COMPARE_MODEL=gemini-3.6-flash

# $5-budget Claude 90-run: Haiku 4.5 ($1/$5 per MTok). Pin the snapshot in the log.
# Sonnet 5 is $3/$15 after 2026-09-01 and can blow a $5 credit on vision screenshots.
# SCIR_COMPARE_PROVIDER=anthropic
# SCIR_COMPARE_MODEL=claude-haiku-4-5-20251001

# Local OpenAI-compatible server (vLLM Qwen, later GPT).
# SCIR_COMPARE_PROVIDER=openai
# SCIR_COMPARE_BASE_URL=http://127.0.0.1:8000/v1
# SCIR_COMPARE_API_KEY=local
# SCIR_COMPARE_MODEL=Qwen3.8-27B

# Live application adapters (optional). Tests skip when the host is missing.
# SCIR_LIBREOFFICE=C:\Program Files\LibreOffice\program
# SCIR_BLENDER=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# SCIR_KRITA=C:\Program Files\Krita (x64)\bin\krita.exe
