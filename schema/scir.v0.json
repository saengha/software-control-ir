{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-control-ir.local/schema/scir.v0.json",
  "title": "Software Control IR v0",
  "description": "Minimal experimental schema for software-facing state, actions, effects, and results.",
  "$defs": {
    "objectId": { "type": "string", "minLength": 1 },
    "json": true,
    "object": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "type": { "type": "string", "minLength": 1 },
        "properties": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["revision", "objects", "selection"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
        "selection": { "type": "array", "items": { "$ref": "#/$defs/objectId" } },
        "meta": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/objectId" },
        "params": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["create", "update", "delete", "select"] },
        "target": { "type": "string" },
        "path": { "type": "string" },
        "from": true,
        "to": true
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "action", "revision", "before", "after", "effects"],
      "properties": {
        "status": { "enum": ["accepted", "rejected", "failed"] },
        "action": { "$ref": "#/$defs/action" },
        "revision": { "type": "integer", "minimum": 0 },
        "before": { "$ref": "#/$defs/state" },
        "after": { "$ref": "#/$defs/state" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "focus": {
          "type": "object",
          "properties": {
            "before": { "$ref": "#/$defs/object" },
            "after": { "$ref": "#/$defs/object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
