  {
    "id": "normal-host-drift",
    "tag": "normal",
    "difficulty": "hard",
    "preset": "board",
    "title": "Recover after host drift",
    "goal": "Change the title to \"Recovered\" and set its fill to #2f6f5f, syncing after the host overwrites the title.",
    "prompt": "Set title_01 text to \"Recovered\". If the host then diverges, call sync before writing again. Finish with text \"Recovered\" and fill #2f6f5f.",
    "hostInject": {
      "action": "set_text",
      "target": "title_01",
      "params": { "value": "Out of band" },
      "trigger": { "id": "title_01", "property": "text", "equals": "Recovered" }
    },
    "scirPlan": [
      {
        "op": "apply",
        "action": {
          "action": "set_text",
          "target": "title_01",
          "params": { "value": "Recovered" }
        }
      },
      { "op": "host_inject" },
      {
        "op": "apply",
        "action": {
          "action": "set_fill",
          "target": "title_01",
          "params": { "value": "#2f6f5f" }
        }
      },
      { "op": "sync" },
      {
        "op": "apply",
        "action": {
          "action": "set_text",
          "target": "title_01",
          "params": { "value": "Recovered" }
        }
      },
      {
        "op": "apply",
        "action": {
          "action": "set_fill",
          "target": "title_01",
          "params": { "value": "#2f6f5f" }
        }
      }
    ],
    "baselineCode": "const title = find(\"title_01\"); title.properties.text = \"Recovered\"; if (hostDiverged()) sync(); title.properties.text = \"Recovered\"; title.properties.fill = \"#2f6f5f\";",
    "expect": {
      "properties": [
        { "id": "title_01", "path": "properties.text", "equals": "Recovered" },
        { "id": "title_01", "path": "properties.fill", "equals": "#2f6f5f" }
      ],
      "unchangedIds": ["logo_01", "accent_01", "body_02"],
      "syncedDrift": true
    }
  },
  {
    "id": "normal-transaction",
    "tag": "normal",
    "difficulty": "medium",
    "preset": "board",
    "title": "Atomic title and accent edit",
    "goal": "In one transaction, set the title to \"Batch Title\" and the accent fill to #2f6f5f.",
    "prompt": "Apply a single transaction that sets title_01 text to \"Batch Title\" and accent_01 fill to #2f6f5f. Both edits are valid and must commit together.",
    "scirPlan": [
      {
        "op": "transaction",
        "actions": [
          {
            "action": "set_text",
            "target": "title_01",
            "params": { "value": "Batch Title" }
          },
          {
            "action": "set_fill",
            "target": "accent_01",
            "params": { "value": "#2f6f5f" }
          }
        ]
      }
    ],
    "baselineCode": "find(\"title_01\").properties.text = \"Batch Title\"; find(\"accent_01\").properties.fill = \"#2f6f5f\";",
    "expect": {
      "properties": [
        { "id": "title_01", "path": "properties.text", "equals": "Batch Title" },
        { "id": "accent_01", "path": "properties.fill", "equals": "#2f6f5f" }
      ],
      "unchangedIds": ["logo_01", "body_02"],
      "rolledBack": false
    }
  },
  {
    "id": "normal-undo",
    "tag": "normal",
    "difficulty": "medium",
    "preset": "board",
    "title": "Undo a title edit",
    "goal": "Set the title to \"Temporary\" and then undo so it returns to \"Quarterly Review\".",
    "prompt": "Set title_01 text to \"Temporary\", then undo that edit with compensation so the title is \"Quarterly Review\" again.",
    "scirPlan": [
      {
        "op": "apply",
        "action": {
          "action": "set_text",
          "target": "title_01",
          "params": { "value": "Temporary" }
        }
      },
      { "op": "undo" }
    ],
    "baselineCode": "find(\"title_01\").properties.text = \"Temporary\"; undo();",
    "expect": {
